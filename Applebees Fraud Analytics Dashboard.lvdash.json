{
  "datasets": [
    {
      "name": "employee_scorecard",
      "displayName": "Gold Employee Fraud Scorecard",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_employee_fraud_scorecard"
      ]
    },
    {
      "name": "hourly_trends",
      "displayName": "Gold Hourly Anomaly Trends",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_hourly_anomaly_trends"
      ]
    },
    {
      "name": "location_summary",
      "displayName": "Gold Location Loss Prevention Summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_location_loss_prevention_summary"
      ]
    },
    {
      "name": "suspect_details",
      "displayName": "Gold Suspect Check Details",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_suspect_check_details"
      ]
    },
    {
      "name": "employee_flags_unpivoted",
      "displayName": "Employee Fraud Flags (Unpivoted)",
      "queryLines": [
        "WITH top_emp AS (\n",
        "  SELECT\n",
        "    employee_name,\n",
        "    LocationId,\n",
        "    total_suspect_checks,\n",
        "    high_val_discount_flags,\n",
        "    low_val_discount_flags,\n",
        "    irregular_hours_flags,\n",
        "    negative_price_flags,\n",
        "    suspicious_togo_flags\n",
        "  FROM\n",
        "    workspace.gold_schema.gold_employee_fraud_scorecard\n",
        "  ORDER BY\n",
        "    total_suspect_checks DESC\n",
        "  LIMIT 15\n",
        ")\n",
        "SELECT\n",
        "  employee_name,\n",
        "  'High Val Discount' AS flag_type,\n",
        "  high_val_discount_flags AS flag_count\n",
        "FROM\n",
        "  top_emp\n",
        "UNION ALL\n",
        "SELECT\n",
        "  employee_name,\n",
        "  'Low Val Discount',\n",
        "  low_val_discount_flags\n",
        "FROM\n",
        "  top_emp\n",
        "UNION ALL\n",
        "SELECT\n",
        "  employee_name,\n",
        "  'Irregular Hours',\n",
        "  irregular_hours_flags\n",
        "FROM\n",
        "  top_emp\n",
        "UNION ALL\n",
        "SELECT\n",
        "  employee_name,\n",
        "  'Negative Price',\n",
        "  negative_price_flags\n",
        "FROM\n",
        "  top_emp\n",
        "UNION ALL\n",
        "SELECT\n",
        "  employee_name,\n",
        "  'Suspicious Togo',\n",
        "  suspicious_togo_flags\n",
        "FROM\n",
        "  top_emp"
      ]
    },
    {
      "name": "top20_employees",
      "displayName": "Top 20 Employees by Suspect Checks",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_employee_fraud_scorecard\n",
        "ORDER BY\n",
        "  total_suspect_checks DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "hourly_totals",
      "displayName": "Hourly Totals Across All Locations",
      "queryLines": [
        "SELECT\n",
        "  hour_of_day,\n",
        "  SUM(suspect_check_count) AS suspect_check_count,\n",
        "  SUM(off_hours_count) AS off_hours_count,\n",
        "  SUM(suspicious_togo_count) AS suspicious_togo_count,\n",
        "  AVG(avg_check_duration_minutes) AS avg_check_duration_minutes\n",
        "FROM\n",
        "  workspace.gold_schema.gold_hourly_anomaly_trends\n",
        "GROUP BY\n",
        "  hour_of_day\n",
        "ORDER BY\n",
        "  hour_of_day"
      ]
    },
    {
      "name": "top15_employees",
      "displayName": "Top 15 Employees by Suspect Checks",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_employee_fraud_scorecard\n",
        "ORDER BY\n",
        "  total_suspect_checks DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "off_hours_filtered",
      "displayName": "Off-Hours Anomaly Trends (2-7 AM)",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_hourly_anomaly_trends\n",
        "WHERE\n",
        "  hour_of_day BETWEEN 2 AND 7\n",
        "ORDER BY\n",
        "  off_hours_count DESC"
      ]
    },
    {
      "name": "top10_location_hourly",
      "displayName": "Top 10 Locations Hourly Trends",
      "queryLines": [
        "WITH top_loc AS (\n",
        "  SELECT\n",
        "    LocationId,\n",
        "    SUM(suspect_check_count) AS total_checks\n",
        "  FROM\n",
        "    workspace.gold_schema.gold_hourly_anomaly_trends\n",
        "  GROUP BY\n",
        "    LocationId\n",
        "  ORDER BY\n",
        "    total_checks DESC\n",
        "  LIMIT 10\n",
        ")\n",
        "SELECT\n",
        "  h.LocationId,\n",
        "  h.hour_of_day,\n",
        "  h.suspect_check_count,\n",
        "  h.off_hours_count,\n",
        "  h.suspicious_togo_count,\n",
        "  h.avg_check_duration_minutes\n",
        "FROM\n",
        "  workspace.gold_schema.gold_hourly_anomaly_trends h\n",
        "    INNER JOIN top_loc t\n",
        "      ON h.LocationId = t.LocationId\n",
        "ORDER BY\n",
        "  h.LocationId ASC,\n",
        "  h.hour_of_day ASC"
      ]
    },
    {
      "name": "top10_locations",
      "displayName": "Top 10 Locations by $ at Risk",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.gold_schema.gold_location_loss_prevention_summary\n",
        "ORDER BY\n",
        "  total_dollars_at_risk DESC\n",
        "LIMIT 10"
      ]
    }
  ],
